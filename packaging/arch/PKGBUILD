# Prepared local alpha recipe; NOT an AUR submission or released archive.
pkgname=steam-omarchy-alpha
pkgver=0.1.0.alpha0
pkgrel=1
pkgdesc='Experimental unofficial local Steam library browser'
arch=('x86_64')
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'pkgconf')
optdepends=('steam: delegated game launching and client features')
# Locally supply this reviewed sanitized source archive. No upstream release exists.
source=('steam-omarchy-source.tar.gz')
sha256sums=('SKIP') # Replace with reviewed archive digest before any distribution.
build() {
  cd "$srcdir/steam-omarchy"
  npm ci
  npm run build
  npm run tauri -- build --no-bundle
}
check() {
  cd "$srcdir/steam-omarchy"
  npm run lint
  cargo test --locked --manifest-path src-tauri/Cargo.toml
}
package() {
  cd "$srcdir/steam-omarchy"
  install -Dm755 src-tauri/target/release/steam-omarchy "$pkgdir/usr/bin/steam-omarchy"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/steam-omarchy.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
  cp -r docs/licenses "$pkgdir/usr/share/licenses/$pkgname/dependencies"
  install -Dm644 packaging/arch/steam-omarchy.desktop "$pkgdir/usr/share/applications/steam-omarchy.desktop"
}
